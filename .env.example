# TrialNavigator environment variables
# Copy this file to .env and fill in values before running locally.
# Never commit .env to git.

# Optional: Buttondown newsletter signup (free tier at buttondown.email)
REACT_APP_BUTTONDOWN_KEY=your_buttondown_api_key_here

# Optional: Anthropic API key for backend translator
# Only required when running backend/translator.py locally
ANTHROPIC_API_KEY=your_anthropic_api_key_here
